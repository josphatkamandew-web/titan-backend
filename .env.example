# Copy to .env for local dev (don't commit the real .env)

# Required for live data
TWELVE_DATA_API_KEY=your_key_here

# Optional locally — leave unset to use a local SQLite file at db/titan.db.
# Required in production (Render sets this automatically if you use render.yaml
# with the attached Postgres database).
DATABASE_URL=

# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=https://titan-vsa-x.netlify.app
# Defaults to "*" (any origin) if unset — fine for local dev, tighten before
# going live.
ALLOWED_ORIGINS=*

# Shared secret the daily GitHub Actions cron job sends to POST /briefing/generate.
# Generate any random string; it just needs to match on both sides (this env
# var here, and the BRIEFING_SECRET repo secret in GitHub Actions).
BRIEFING_SECRET=
